63], [260271, "蘇利‧麥拉利"], ["塵泥沼澤", [63.4, 42.4]], [], [], "小心背後 到塵泥沼澤找蘇利‧麥拉利了解任務。"], "95198": [[95194, 95196, 95198, 95262, 95263], [260271, "蘇利‧麥拉利"], ["塵泥沼澤", [63.4, 42.4]], [], [], "王者歸來？ 用軍情七處偽裝工具組在塞拉摩法師塔竊聽珍娜。"], "95263": [[95194, 95196, 95198, 95262, 95263], [260271, "蘇利‧麥拉利"], ["塵泥沼澤", [63.4, 42.4]], [], [], "噩耗 回到塵泥沼澤找蘇利‧麥拉利。"], "95483": [[95454, 96369, 95483], [4949, "索爾"], ["奧格瑪", [32, 37.8]], [], [279831, 279833, 279474], "索爾必須知道 將瓦里安‧烏瑞恩命運的消息帶給奧格瑪的索爾。"], "95809": [[95647, 95809], [1480, "凱特林·格拉斯曼"], ["濕地", [11.8, 58.8]], [2459, 280766], [1710, 3827], "編織之心 回去米奈希爾港找凱特林‧格拉斯曼。"], "98824": [[95810, 98824], [5387, "資深探險家麥格拉斯"], ["鐵爐堡", [69.6, 18.6]], [], [271716, 271767, 271766], "史前稜石 將泰坦聖物帶去鐵爐堡探險者大廳給資深探險家麥格拉斯。"]}